{
  "name": "lollipop-clicker",
  "version": "3.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "node scripts/check.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test:browser": "python3 tests/browser_smoke.py",
    "android:prepare": "node scripts/android-web.mjs",
    "android:sync": "npm run android:prepare && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.3",
    "@capacitor/splash-screen": "7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "esbuild": "0.25.12"
  }
}
